{
  "name": "faithful-field",
  "type": "module",
  "version": "4.0.2-beta",
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro-pure check && astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "astro": "astro",
    "pure": "astro-pure",
    "new": "astro-pure new",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "npm run lint && npm run sync && npm run check && npm run format",
    "clean": "rm -rf .astro .vercel dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.22",
    "@waline/client": "^3.16.2",
    "astro": "^7.4.13",
    "astro-pure": "1.4.9",
    "katex": "^0.19.1",
    "rehype": "^13.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "unocss": "^66.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "astro": "$astro",
    "@astrojs/mdx": "^8.1.6",
    "katex": "$katex",
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  }
}
