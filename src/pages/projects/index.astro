---
import { Collapse } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'my-projects', text: 'My Projects' },
  { depth: 2, slug: 'collab', text: 'Collaborative Projects' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'hackathons', text: 'Hackathons' },
  { depth: 2, slug: 'others', text: 'Others' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activity:</p>
  <p>
    <img
      src='https://ghchart.rshah.org/659eb9/JareCoder'
      alt='github activity table'
      loading='lazy'
    />
  </p>
  <p>
    Take a peek at some of my projects and learnings below. Due to the nature of my work and
    contributions, some projects may be private or not publicly available. You can read about them
    in the linked blog posts!
  </p>
  <p>
    Find something interesting and want to know more? Feel free to reach out on <a
      class='text-muted-foreground'
      href='/about#social-networks'>LinkedIn</a
    >!
  </p>

  <h2 id='my-projects'>My Projects</h2>
  <ProjectSection
    projects={[
      {
        name: 'Inssiless Math',
        description: 'Small web app for practising engineering math exercises',
        links: [{ type: 'github', href: 'https://github.com/JareCoder/inssiless_math' }]
      },
      {
        name: 'LounasMCP',
        description: 'MCP server for daily lunch menus at Sello, Espoo',
        links: [{ type: 'github', href: 'https://github.com/JareCoder/LounasMCP' }]
      },
      {
        name: 'Pocket Rocket',
        description: 'Retro 2D arcade shooter made with Godot',
        links: [
          { type: 'site', href: 'https://rocket.jemlap.fi' },
          { type: 'github', href: 'https://github.com/JareCoder/pocket-rocket-godot' }
        ]
      },
      {
        name: 'Kingshot Redeemer',
        description: 'Discord bot that automates Kingshot gift code redemption',
        links: [
          { type: 'github', href: 'https://github.com/JareCoder/KingshotRedeemer' },
          { type: 'release', href: 'https://hub.docker.com/r/jarecoder/kingshot-redeemer' }
        ]
      },
      {
        name: 'Shibuya Movies',
        description: 'React Vite and Node app to vote for movies to watch',
        links: [
          { type: 'site', href: 'https://movies.jemlap.fi' },
          { type: 'github', href: 'https://github.com/JareCoder/ShibuyaMovies' }
        ]
      },
      {
        name: 'Random Beep App',
        description: 'A simple Win app to play randomly timed beeps for coaching',
        links: [
          { type: 'github', href: 'https://github.com/JareCoder/RandomBeepApp' },
          { type: 'release', href: 'https://github.com/JareCoder/RandomBeepApp/releases' }
        ]
      },
      {
        name: 'Photography Portfolio',
        description: 'A simple photography portfolio for a friend',
        links: [
          { type: 'site', href: 'https://www.andreashartman.com/' },
          { type: 'github', href: 'https://github.com/JareCoder/photographyPortfolio' }
        ]
      },
      {
        name: 'Shibuya App (WIP)',
        description: 'Flutter project for a private social media app',
        links: [{ type: 'github', href: 'https://github.com/JareCoder/ShibuyaComics' }]
      },
      {
        name: 'RTMP Installer (WIP)',
        description: 'A script to install and configure RTMP server using Nginx',
        links: [{ type: 'github', href: 'https://github.com/JareCoder/RTMP-Nginx-Installer' }]
      },
      {
        name: 'Scripts repo',
        description: 'Checkout recursive image resizer for Win',
        links: [
          { type: 'github', href: 'https://github.com/JareCoder/Scripts' },
          {
            type: 'release',
            href: 'https://github.com/JareCoder/Scripts/releases/tag/ImageResizer_v1.0'
          }
        ]
      }
    ]}
  />

  <h2 id='collab'>Collaborative Projects</h2>
  <ProjectSection
    projects={[
      {
        name: 'Root IT Career Fair',
        description: 'A website for a career fair event',
        links: [{ type: 'site', href: 'https://rootexpo.fi' }]
      },
      {
        name: 'Digit App',
        description: 'Mobile app (Flutter) for Digit ry student organization',
        links: [
          { type: 'site', href: 'https://play.google.com/store/apps/details?id=co.mankeli.digit' }
        ]
      },
      {
        name: 'Digit ry Infrastructure',
        description: 'Website and member register for Digit ry hosted on AWS',
        links: [
          { type: 'site', href: 'https://digit.fi/en' }
          //{ type: 'doc', href: 'fix-this'}
        ]
      }
    ]}
  />

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'Full Stack Open',
        description: 'Full Stack Open course by University of Helsinki',
        links: [
          { type: 'github', href: 'https://github.com/JareCoder/FullStackOpen' },
          { type: 'site', href: 'https://fullstackopen.com/en/' }
        ]
      },
      {
        name: 'CodeMonkey Unity Course',
        description: 'Unity course by CodeMonkey.', //Game is self hosted under first link!',
        links: [
          //{ type: 'release', href: 'fix-this' },
          //{ type: 'github', href: 'figure this one out'},
          { type: 'site', href: 'https://unitycodemonkey.com/kitchenchaoscourse.php' }
        ]
      }
    ]}
  />

  <Collapse title='Some uni courses & earlier education'>
    <ProjectSection
      projects={[
        {
          name: 'Computer Architecture Demonstration',
          description: 'Course group project using Python',
          links: [
            {
              type: 'github',
              href: 'https://github.com/JareCoder/ComputerArchitectureDemonstration'
            }
          ]
        },
        {
          name: 'Text To Speech',
          description: 'Kerttuli ICT school final project made for a company',
          links: [{ type: 'github', href: 'https://github.com/JareCoder/TextToSpeech' }]
        }
      ]}
    />
  </Collapse>

  <h2 id='hackathons'>Hackathons</h2>
  <ProjectSection
    projects={[
      {
        name: 'S.I.MO',
        description: 'Junction 2026 1st place in Valio Aimo track',
        links: [
          { type: 'github', href: 'https://github.com/Mankeli-Software/junction-2026' },
          { type: 'site', href: 'https://youtu.be/6tDLRYDyZmE' }
        ]
      },
      {
        name: 'Takomo Fitter Studio',
        description: 'Since AI Hackathon 2026 top 4-6 in Takomo track',
        links: [
          { type: 'github', href: 'https://github.com/Mankeli-Software/since-ai-2026' },
          { type: 'site', href: 'https://fitteri.mankelisolutions.fi/' }
        ]
      },
      {
        name: 'Lost in the Mes(h)s',
        description: 'Aalto Defence Hackathon 2026 1st place in Kova Labs Tactical Mesh track',
        links: [{ type: 'github', href: 'https://github.com/nipatiitti/lost-in-the-mess' }]
      },
      {
        name: 'Feissari',
        description: 'Junction 2025 winner of Best use of Gemini API',
        links: [{ type: 'github', href: 'https://github.com/Mankeli-Software/feissari' }]
      },
      {
        name: 'QuickBim',
        description: 'Junction 2024 3rd place overall',
        links: [
          { type: 'github', href: 'https://github.com/Mankeli-Software/quickbim' },
          { type: 'doc', href: '/blog/junction-2024' }
        ]
      },
      {
        name: 'J-mp',
        description: 'Junction 2023 2nd place in Huawei track',
        links: [{ type: 'github', href: 'https://github.com/Mankeli-Software/junction2023' }]
      },
      {
        name: 'BoxBunny',
        description: 'Junction 2022 top 30 in Wolt track',
        links: [{ type: 'github', href: 'https://github.com/Mankeli-Software/BoxBunny' }]
      }
    ]}
  />

  <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: 'Mankeli Solutions Oy',
        description: "Mankeli's Github",
        links: [{ type: 'github', href: 'https://github.com/Mankeli-Software' }]
      },
      {
        name: 'Gigi',
        description: 'Home services booking app',
        links: [{ type: 'site', href: 'https://gigiapp.fi' }]
      }
    ]}
  />
</PageLayout>
